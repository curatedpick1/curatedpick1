---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import StoreBrand from '../../components/StoreBrand.astro';
import BlogContent from '../../components/BlogContent.astro';
import RetailerDetails from '../../components/RetailerDetails.astro';
import Icon from '../../components/Icon.astro';
import { getCatalog } from '../../lib/catalog';
import { relatedProducts, merchantHost } from '../../../shared/catalog';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
const catalog = await getCatalog();
const product = catalog.products.find(candidate => candidate.slug === Astro.params.slug);
if (!product) Astro.response.status = 404;
const related = product ? relatedProducts(product, catalog.products) : [];
const photos=product?.images?.length?product.images:product?[{url:product.poster_url,alt:product.poster_alt}]:[];
const primaryStore=product?.stores.find(store=>store.name.toLowerCase()==='amazon') || product?.stores[0];
const otherStores=product?.stores.filter(store=>store!==primaryStore) || [];
const hasBlog=Boolean(product?.blog_content?.length);
const hasRelated=related.length > 0;
const storeKey=(name='other')=>name.toLowerCase().replace(/[^a-z]/g,'').replace('bestbuy','bestbuy');
---
{product ? (
<Layout title={`${product.title} — The Curated Pick`} description={product.description} image={product.poster_url} demo={catalog.demo} catalogRevision={catalog.revision}>
  <div class="detail-toolbar wrap"><a href="/#discover" class="back-link"><Icon name="back" size={17} /> Back to the finds</a><div><button class="share-button" id="share-product"><Icon name="share" size={16} /> Share find</button><span class="sr-only share-status" id="share-status" role="status"></span></div></div>
  <div class="share-fallback wrap" id="share-fallback" hidden><label for="share-url">Copy this product link to share it</label><input id="share-url" type="url" readonly /></div>
  <section class="product-detail wrap" data-product-id={product.id} data-product-revision={product.revision}>
    <div class="product-gallery">
      <button class="detail-image gallery-zoom" type="button" aria-label="Enlarge product photo"><img id="gallery-main" src={product.poster_url} alt={product.poster_alt} width="1200" height="1500" fetchpriority="high" /></button>
      <p class="gallery-caption">Click the photo for a closer look <span id="gallery-position">1 / {photos.length}</span></p>
      {photos.length>1 && <div class="gallery-thumbs" aria-label="Product photos">{photos.map((photo,index)=><button type="button" data-gallery-url={photo.url} data-gallery-alt={photo.alt || product.poster_alt} aria-label={`Show photo ${index+1}`} aria-pressed={photo.url===product.poster_url}><img src={photo.url} alt="" width="80" height="100" loading="lazy" /></button>)}</div>}
    </div>
    <div class="detail-copy">
      <a class="eyebrow category-link" href={`/?category=${encodeURIComponent(product.category)}#discover`}>{product.category} <Icon name="arrow" size={14} /></a>
      <h1>{product.title}</h1>
      {primaryStore && <RetailerDetails store={primaryStore} mode="reviews" />}
      {primaryStore && <div class="primary-offer">
        <div class="offer-heading"><StoreBrand name={primaryStore.name} /><span class="offer-link-note">Checkout on the retailer’s website</span></div>
        <RetailerDetails store={primaryStore} mode="price" />
        <a href={primaryStore.url} class="primary-store-button" data-store={storeKey(primaryStore.name)} target="_blank" rel="sponsored nofollow noopener noreferrer"><span>Check price at {primaryStore.name}</span><Icon name="arrow" size={19} /></a>
        <p class="affiliate-note">We may earn a commission from qualifying purchases, at no extra cost to you. <a href="/disclosure/">Affiliate disclosure</a></p>
      </div>}
      <section class="about-find" aria-labelledby="about-find-title"><h2 id="about-find-title">About this item</h2><p>{product.description}</p>
      </section>
      {otherStores.length > 0 && <section class="other-stores" aria-labelledby="other-stores-title"><h2 id="other-stores-title">Also available at</h2><div class="store-list">{otherStores.map((store) => <a href={store.url} class="store-button" data-store={storeKey(store.name)} target="_blank" rel="sponsored nofollow noopener noreferrer"><StoreBrand name={store.name} /><span class="store-label"><small>{store.note || merchantHost(store.url)}</small></span><Icon name="arrow" size={20} /></a>)}</div></section>}
      {!primaryStore && <div class="store-empty"><p>Store links are coming soon.</p><span>Explore more finds while we finish this one.</span></div>}
      <p class="purchase-note">The retailer handles payment, delivery and returns.</p>
    </div>
  </section>
  {(hasRelated || hasBlog) && <section class:list={['product-lower', 'wrap', hasRelated && 'has-related', hasBlog && 'has-blog']}>
  {related.length > 0 && <section class="related-section" aria-labelledby="related-title"><div class="section-heading"><div><p class="eyebrow">MORE IN {product.category}</p><h2 id="related-title">Similar finds</h2></div></div><div class="product-grid related-grid">{related.map((pick, index) => <ProductCard product={pick} index={index + 2} />)}</div><a class="text-link" href={`/?category=${encodeURIComponent(product.category)}#discover`}>Explore this category <Icon name="right" size={16} /></a></section>}
  {hasBlog && <article class="product-blog" aria-labelledby="product-blog-title">
    <header><p class="eyebrow">THE JOURNAL</p><h2 id="product-blog-title">{product.blog_title}</h2><a class="text-link" href={`/blog/${product.slug}/`}>Read & share this article <Icon name="arrow" size={16} /></a></header>
    <BlogContent blocks={product.blog_content} />
  </article>}
  </section>}
  <dialog class="photo-dialog" id="photo-dialog" aria-label="Enlarged product photo"><button type="button" id="close-photo">Close ×</button><img id="zoom-photo" src={product.poster_url} alt={product.poster_alt} /></dialog>
</Layout>
) : (
  <Layout title="Find not found — The Curated Pick" noindex>
    <section class="empty-state wrap"><h1>This find is not available.</h1><p>It may have been removed or the link may be incorrect.</p><a class="pill-button" href="/#discover">Browse current finds</a></section>
  </Layout>
)}
<script>
  const photoDialog=document.querySelector<HTMLDialogElement>('#photo-dialog');
  document.querySelector('.gallery-zoom')?.addEventListener('click',()=>{
    const main=document.querySelector<HTMLImageElement>('#gallery-main');
    const zoom=document.querySelector<HTMLImageElement>('#zoom-photo');
    if(main&&zoom){zoom.src=main.src;zoom.alt=main.alt;photoDialog?.showModal();}
  });
  document.querySelector('#close-photo')?.addEventListener('click',()=>photoDialog?.close());
  photoDialog?.addEventListener('click',e=>{if(e.target===photoDialog)photoDialog.close();});
  for(const thumbnail of document.querySelectorAll<HTMLButtonElement>('[data-gallery-url]'))thumbnail.addEventListener('click',()=>{
    const main=document.querySelector<HTMLImageElement>('#gallery-main');if(!main)return;
    main.src=thumbnail.dataset.galleryUrl!;main.alt=thumbnail.dataset.galleryAlt || '';
    for(const button of document.querySelectorAll('[data-gallery-url]'))button.setAttribute('aria-pressed',String(button===thumbnail));
    const thumbs=[...document.querySelectorAll('[data-gallery-url]')];
    const position=document.querySelector('#gallery-position');if(position)position.textContent=`${thumbs.indexOf(thumbnail)+1} / ${thumbs.length}`;
  });
  const button = document.querySelector<HTMLButtonElement>('#share-product');
  const status = document.querySelector('#share-status');
  button?.addEventListener('click', async () => {
    const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
    const title = document.querySelector('h1')?.textContent || 'The Curated Pick';
    try {
      if (navigator.share) { await navigator.share({ title, url }); return; }
      await navigator.clipboard.writeText(url);
      if (status) status.textContent = 'Product link copied.';
      button.textContent = 'Link copied!';
      setTimeout(() => { button.textContent = 'Share find'; }, 2500);
    } catch (error) {
      if (error instanceof Error && error.name === 'AbortError') return;
      const fallback = document.querySelector<HTMLElement>('#share-fallback');
      const input = document.querySelector<HTMLInputElement>('#share-url');
      if (fallback && input) { fallback.hidden = false; input.value = url; input.focus(); input.select(); }
      if (status) status.textContent = 'Copy the link from the field above the product.';
    }
  });
</script>
<style>
  .product-detail{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:32px;align-items:start;padding-bottom:56px}
  .product-gallery,.detail-copy{min-width:0;border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:20px}
  .product-gallery{position:sticky;top:24px}.detail-copy{padding:28px}
  .product-gallery .detail-image{display:block;position:static;width:100%;padding:12px;border:1px solid #e9e9e9;border-radius:12px;background:#fff;cursor:zoom-in;overflow:hidden}
  .detail-image img{width:100%;height:auto;aspect-ratio:1;object-fit:contain;background:#fff;transition:transform .3s ease}
  .detail-image:hover img{transform:scale(1.025)}
  .gallery-caption{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--muted);margin-top:12px}
  .gallery-thumbs{display:flex;gap:10px;overflow-x:auto;margin-top:16px;padding:4px}
  .gallery-thumbs button{flex:0 0 64px;padding:4px;border:1px solid var(--line);border-radius:9px;background:#fff}
  .gallery-thumbs button[aria-pressed=true]{outline:2px solid var(--green);outline-offset:1px}
  .gallery-thumbs img{width:100%;height:58px;object-fit:contain}
  .category-link{display:inline-flex;gap:6px;align-items:center;color:var(--green);font-size:11px}
  .detail-copy h1{font-size:clamp(27px,3vw,38px);line-height:1.15;letter-spacing:-.035em;margin:12px 0 24px;color:var(--ink)}
  .primary-offer{padding:20px;background:var(--paper);border:1px solid var(--line);border-radius:12px}
  .offer-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:20px}
  .offer-link-note{font-size:12px;color:var(--muted);text-align:right;max-width:145px}
  .primary-store-button{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;min-height:50px;border-radius:9px;background:#006b5b;color:#fff;font-size:15px;font-weight:750;transition:transform .18s,filter .18s}
  .primary-store-button:hover{transform:translateY(-2px);filter:brightness(1.07)}
  .primary-store-button[data-store=amazon]{background:#ff9900;color:#182235}
  .primary-store-button[data-store=walmart]{background:#0071ce}
  .primary-store-button[data-store=daraz]{background:#c43b00}
  .primary-store-button[data-store=aliexpress]{background:#c5261d}
  .primary-store-button[data-store=alibaba]{background:#bc4900}
  .primary-store-button[data-store=temu]{background:#b53d00}
  .review-link{display:inline-flex;gap:5px;align-items:center;min-height:44px;font-size:13px;color:var(--green);text-decoration:underline;text-underline-offset:4px}
  .primary-offer .affiliate-note{font-size:11px;color:var(--muted);line-height:1.65;margin:4px 0 0}
  .about-find,.other-stores{padding-top:24px;margin-top:24px;border-top:1px solid var(--line)}
  .about-find h2,.other-stores h2{font-size:15px;color:var(--ink);letter-spacing:0}
  .about-find p{font-size:15px;line-height:1.85;color:var(--muted);margin-top:12px;white-space:pre-line}
  .other-stores .store-list{margin-top:14px;gap:10px}
  .store-button{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);transition:transform .18s,border-color .18s}
  .store-button:hover{border-color:var(--green);transform:translateX(2px)}
  .store-label{margin-left:auto}.store-label small{color:var(--muted);font-size:11px}
  .purchase-note{color:var(--muted);font-size:12px;margin:20px 0 0}
  .product-lower{display:grid;grid-template-columns:1fr;gap:32px;align-items:start;padding-bottom:64px}
  .product-lower.has-related.has-blog{grid-template-columns:minmax(0,1fr) minmax(0,3fr)}
  .product-lower .related-section{min-width:0;margin:0;padding:0;border:0}
  .product-lower .section-heading{display:block;margin-bottom:20px}
  .section-heading .eyebrow{font-size:10px;color:var(--muted);margin-bottom:8px}
  .section-heading h2{font-size:22px}
  .product-lower .related-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .product-lower.has-blog .related-grid{grid-template-columns:1fr}
  .product-blog{min-width:0;max-width:none;padding:32px 36px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
  .product-blog>header{padding:0 0 24px;margin:0 0 24px;max-width:none;border-bottom:1px solid var(--line)}
  .product-blog>header h2{font-family:var(--sans);font-size:clamp(26px,3vw,36px);font-weight:650;letter-spacing:-.025em;margin:12px 0 4px}
  .photo-dialog{padding:16px;border:1px solid var(--line);border-radius:16px;background:var(--surface);color:var(--ink);max-width:95vw;max-height:94vh}
  .photo-dialog::backdrop{background:#070b14cc}
  .photo-dialog img{max-width:85vw;max-height:76vh;object-fit:contain;background:#fff}
  .photo-dialog button{display:block;margin:0 0 12px auto;padding:8px 16px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink)}
  @media(max-width:800px){.product-detail{grid-template-columns:1fr;gap:18px}.product-gallery{position:static}.detail-copy{padding:22px}.product-lower.has-related.has-blog{grid-template-columns:1fr}.product-lower.has-blog .product-blog{grid-row:1}.product-lower .related-grid,.product-lower.has-blog .related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.product-blog{padding:24px}.store-label{display:none}}
  @media(prefers-reduced-motion:reduce){.detail-image img,.primary-store-button,.store-button{transition:none}}
</style>
