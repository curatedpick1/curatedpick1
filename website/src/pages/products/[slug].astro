---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import { getCatalog } from '../../lib/catalog';
import { relatedProducts, merchantHost } from '../../../shared/catalog';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
const catalog = await getCatalog();
const product = catalog.products.find(candidate => candidate.slug === Astro.params.slug);
const demo = catalog.demo;
if (!product) Astro.response.status = 404;
const related = product ? relatedProducts(product, catalog.products) : [];
const photos=product?.images?.length?product.images:product?[{url:product.poster_url,alt:product.poster_alt}]:[];
---
{product ? (
<Layout title={`${product.title} — The Curated Pick`} description={product.description} image={product.poster_url} demo={catalog.demo} catalogRevision={catalog.revision}>
  <div class="detail-toolbar wrap"><a href="/#discover" class="back-link"><Icon name="back" size={17} /> Back to the finds</a><div><button class="share-button" id="share-product"><Icon name="share" size={16} /> Share find</button><span class="sr-only share-status" id="share-status" role="status"></span></div></div>
  <div class="share-fallback wrap" id="share-fallback" hidden><label for="share-url">Copy this product link to share it</label><input id="share-url" type="url" readonly /></div>
  <section class="product-detail wrap" data-product-id={product.id} data-product-revision={product.revision}>
    <div class="product-gallery">
      <div class="detail-image"><img id="gallery-main" src={product.poster_url} alt={product.poster_alt} width="1200" height="1500" fetchpriority="high" /><span class="detail-image-note">A closer look</span></div>
      {photos.length>1 && <div class="gallery-thumbs" aria-label="Product photos">{photos.map((photo,index)=><button type="button" data-gallery-url={photo.url} data-gallery-alt={photo.alt || product.poster_alt} aria-label={`Show photo ${index+1}`} aria-pressed={photo.url===product.poster_url}><img src={photo.url} alt="" width="80" height="100" loading="lazy" /></button>)}</div>}
    </div>
    <div class="detail-copy"><a class="eyebrow category-link" href={`/?category=${encodeURIComponent(product.category)}#discover`}>{product.category} <Icon name="arrow" size={14} /></a><h1>{product.title}</h1><p class="product-description">{product.description}</p>
      <div class="store-section"><div class="store-heading"><h2>Like it? Choose your store.</h2><p>Check current prices, options & delivery.</p></div>
        {product.stores.length ? <div class="store-list">{product.stores.map((store) => <a href={store.url} class="store-button" target="_blank" rel="sponsored nofollow noopener noreferrer"><span class="store-monogram" aria-hidden="true">{store.name.slice(0, 1).toUpperCase()}</span><span class="store-label"><strong>View on {store.name}</strong><small>{store.note || merchantHost(store.url)}</small></span><Icon name="arrow" size={20} /></a>)}</div> : <div class="store-empty"><p>{demo ? 'Example store choices' : 'Store links are coming soon.'}</p><span>{demo ? 'These sample buttons are inactive. Your actual store links will appear here after setup.' : 'Explore more finds while we finish this one.'}</span></div>}
        {demo && !product.stores.length && <div class="store-list" aria-label="Example store buttons, inactive in preview">{['Amazon', 'AliExpress'].map(name => <button class="store-button" disabled><span class="store-monogram" aria-hidden="true">{name.slice(0, 1)}</span><span class="store-label"><strong>View on {name}</strong><small>Example only</small></span><Icon name="arrow" size={20} /></button>)}</div>}
        <p class="purchase-note">You’ll order directly from your chosen store. Check the exact model, seller, shipping, and return terms there.</p>
        <p class="affiliate-note">We may earn a commission when you shop through these links, at no extra cost to you. <a href="/disclosure/">How our links work</a></p>
      </div>
      {product.tags.length > 0 && <nav class="product-tags" aria-label="Explore related interests">{product.tags.map(tag => <a href={`/?q=${encodeURIComponent(tag)}#discover`}>{tag}</a>)}</nav>}
    </div>
  </section>
  {related.length > 0 && <section class="related-section wrap" aria-labelledby="related-title"><div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2 id="related-title">You might like these too</h2></div><a class="text-link" href="/#discover">View all finds <Icon name="right" size={16} /></a></div><div class="product-grid related-grid">{related.map((pick, index) => <ProductCard product={pick} index={index + 2} />)}</div></section>}
</Layout>
) : (
  <Layout title="Find not found — The Curated Pick" noindex>
    <section class="empty-state wrap"><h1>This find is not available.</h1><p>It may have been removed or the link may be incorrect.</p><a class="pill-button" href="/#discover">Browse current finds</a></section>
  </Layout>
)}
<script>
  for(const thumbnail of document.querySelectorAll<HTMLButtonElement>('[data-gallery-url]'))thumbnail.addEventListener('click',()=>{
    const main=document.querySelector<HTMLImageElement>('#gallery-main');if(!main)return;
    main.src=thumbnail.dataset.galleryUrl!;main.alt=thumbnail.dataset.galleryAlt || '';
    for(const button of document.querySelectorAll('[data-gallery-url]'))button.setAttribute('aria-pressed',String(button===thumbnail));
  });
  const button = document.querySelector<HTMLButtonElement>('#share-product');
  const status = document.querySelector('#share-status');
  button?.addEventListener('click', async () => {
    const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
    const title = document.querySelector('h1')?.textContent || 'The Curated Pick';
    try {
      if (navigator.share) { await navigator.share({ title, url }); return; }
      await navigator.clipboard.writeText(url);
      if (status) status.textContent = 'Product link copied.';
      button.textContent = 'Link copied!';
      setTimeout(() => { button.textContent = 'Share find'; }, 2500);
    } catch (error) {
      if (error instanceof Error && error.name === 'AbortError') return;
      const fallback = document.querySelector<HTMLElement>('#share-fallback');
      const input = document.querySelector<HTMLInputElement>('#share-url');
      if (fallback && input) { fallback.hidden = false; input.value = url; input.focus(); input.select(); }
      if (status) status.textContent = 'Copy the link from the field above the product.';
    }
  });
</script>
<style>
  .product-gallery{position:sticky;top:95px;min-width:0}.product-gallery .detail-image{position:relative;top:auto}.product-gallery .detail-image img{aspect-ratio:4/5;object-fit:contain;background:white}.gallery-thumbs{display:flex;gap:10px;overflow-x:auto;padding:12px 2px}.gallery-thumbs button{flex:0 0 70px;border:2px solid transparent;border-radius:8px;padding:3px;background:white;cursor:pointer}.gallery-thumbs button[aria-pressed=true]{border-color:var(--green)}.gallery-thumbs img{display:block;width:100%;height:80px;object-fit:contain}.gallery-thumbs button:focus-visible{outline:2px solid var(--green);outline-offset:2px}@media(max-width:650px){.product-gallery{position:static}}
</style>
