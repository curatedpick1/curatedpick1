---
import Icon from './Icon.astro';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'curatedpick.store@gmail.com';
const pinterest = import.meta.env.PUBLIC_PINTEREST_URL || 'https://www.pinterest.com/thecuratedpick1/';
---
<section class="contact-section wrap" id="contact" aria-labelledby="contact-title">
  <div class="contact-copy"><p class="eyebrow">THERE’S A PERSON BEHIND THE PICKS</p><h2 id="contact-title">A question?<br />A good find?<br /><span>Say hello.</span></h2><p>Spotted a broken link, have a product in mind, or want to work together? We’d like to hear from you.</p><a class="contact-email" href={`mailto:${email}`}>{email} <Icon name="arrow" size={18} /></a><div class="contact-links"><a href={pinterest} target="_blank" rel="noopener noreferrer">Pinterest ↗</a><button data-open-assistant>Ask the assistant ↗</button></div></div>
  <form class="contact-form" id="contact-form" data-email={email}><h3>Leave us a note</h3><p>This opens your email app with a draft. Nothing is sent until you send it there.</p><label for="contact-name">Your name <span>(optional)</span></label><input id="contact-name" name="name" autocomplete="name" maxlength="100" placeholder="What should we call you?" /><label for="contact-topic">What’s it about?</label><select id="contact-topic" name="topic"><option>Product question</option><option>Report a broken link</option><option>Collaboration</option><option>Something else</option></select><label for="contact-message">Your message</label><textarea id="contact-message" name="message" rows="4" maxlength="2000" required placeholder="Tell us a little more…"></textarea><button class="pill-button" type="submit">Open email draft <Icon name="arrow" size={17} /></button><p id="contact-status" role="status"></p></form>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const message = String(data.get('message') || '').trim();
    if (!message) { document.querySelector<HTMLTextAreaElement>('#contact-message')?.focus(); return; }
    const subject = `The Curated Pick: ${data.get('topic')}`;
    const body = `${message}${name ? `\n\nFrom: ${name}` : ''}`;
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    const status = document.querySelector('#contact-status');
    if (status) status.textContent = 'Your email app should open with a draft. If it does not, use the email address beside this form. Your message has not been sent by this website.';
  });
</script>
