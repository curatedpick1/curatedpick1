---
import type { ProductBlogBlock } from '../../shared/catalog';
const { blocks = [] } = Astro.props as { blocks?: ProductBlogBlock[] };
---
<div class="product-blog-body">
  {blocks.map(block => {
    if (block.type === 'image') return <figure style={`justify-content:${block.align === 'left' ? 'flex-start' : block.align === 'right' ? 'flex-end' : 'center'}`}><img src={block.url} alt={block.alt} style={`width:${block.width || 100}%`} loading="lazy" /></figure>;
    if (block.type === 'rich_text') {
      const Tag = block.tag;
      return <Tag class={`blog-rich-text ${block.tag === 'p' ? 'blog-rich-paragraph' : ''}`} style={`text-align:${block.align}`}>{block.runs.map(run => <span class:list={[run.bold && 'blog-bold',run.italic && 'blog-italic',run.underline && 'blog-underlined',run.size && `blog-size-${run.size}`,run.font && `blog-font-${run.font.toLowerCase().replaceAll(' ','-')}`]}>{run.text}</span>)}</Tag>;
    }
    if (block.type === 'heading') return <h3>{block.text}</h3>;
    return <p class:list={[block.type === 'underline' && 'blog-underline']}>{block.text}</p>;
  })}
</div>
<style>
  .product-blog-body{max-width:740px;overflow-wrap:anywhere;color:var(--ink)}
  .product-blog-body :global(p){font-size:16px;line-height:1.85;color:var(--muted)}
  figure{display:flex;margin:28px 0}figure img{height:auto;max-width:100%;border-radius:10px}
</style>
