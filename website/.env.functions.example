# Private Supabase function secrets. Copy to .env.functions, fill, then deploy with:
# npx supabase secrets set --env-file .env.functions
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
SITE_URL=https://YOUR-REAL-DOMAIN.example
SITE_DEPLOY_HOOK=https://YOUR-PRIVATE-DEPLOY-HOOK.example
PUBLISHER_SECRET=REPLACE-WITH-A-RANDOM-64-CHARACTER-SECRET
PINTEREST_APP_ID=YOUR-APP-ID
PINTEREST_APP_SECRET=YOUR-APP-SECRET
PINTEREST_API_ENV=sandbox
PINTEREST_STANDARD_ACCESS=false
PINTEREST_PUBLISHING_ENABLED=false
