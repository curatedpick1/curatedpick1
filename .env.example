# Copy to .env. Dev mode uses clearly labelled sample products without credentials.
# Production builds require these three values and never silently use samples.
SITE_URL=https://YOUR-DOMAIN.example
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Optional public profile / site ownership metadata
PUBLIC_CONTACT_EMAIL=curatedpick.store@gmail.com
PUBLIC_PINTEREST_URL=https://www.pinterest.com/thecuratedpick1/
PUBLIC_PINTEREST_VERIFY=
# Set true only for an explicitly labelled preview, never your live affiliate site.
DEMO_MODE=false
