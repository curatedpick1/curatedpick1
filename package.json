{
  "name": "the-curated-pick-final",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "build:demo": "node scripts/build-demo.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:build": "node tests/build-render.mjs",
    "pinterest:connect": "node --env-file=.env.publisher scripts/connect-pinterest.mjs",
    "publisher:run": "node --env-file=.env.publisher scripts/run-publisher.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "^0.3.14",
    "typescript": "~5.8.2"
  }
}
